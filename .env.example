# ─────────────────────────────────────────────────────────
# LittleSeed — Environment variables
# Copy this file to .env.local for local dev,
# and set the same variables in Vercel → Settings → Environment Variables
# ─────────────────────────────────────────────────────────

# Supabase project URL  (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key  (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key  (NEVER expose — server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical URL for your site (OG tags, sitemap, auth redirects)
NEXT_PUBLIC_BASE_URL=https://littleseed.app

# Optional: CDN prefix if you serve assets from a custom domain
NEXT_PUBLIC_ASSET_BASE_URL=https://your-project.supabase.co/storage/v1/object/public/coloring

# ─────────────────────────────────────────────────────────
# Supabase Dashboard settings (one-time, not env vars)
#   Auth → URL Configuration → Site URL:
#     https://littleseed.app
#   Auth → URL Configuration → Redirect URLs:
#     https://littleseed.app/auth/callback
#     http://localhost:3000/auth/callback   (for local dev)
# ─────────────────────────────────────────────────────────
